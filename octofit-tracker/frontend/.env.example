# VITE_CODESPACE_NAME must be defined for the frontend to reach the Codespaces-hosted
# backend API at https://${VITE_CODESPACE_NAME}-8000.app.github.dev.
# Copy this file to .env.local and set the value to your Codespace name
# (e.g. the $CODESPACE_NAME environment variable value).
VITE_CODESPACE_NAME=
